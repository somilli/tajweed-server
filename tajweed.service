[Unit]
Description=Sabaq tajweed-check server (Quran Muaalem)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tajweed
EnvironmentFile=/etc/tajweed/.env
ExecStart=/opt/tajweed/venv/bin/uvicorn app.server:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
# The model loads in ~11 s; give the first start plenty of time.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
